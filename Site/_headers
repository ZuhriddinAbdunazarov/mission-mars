# Netlify headers.
# The Unity build files (.unityweb) are Brotli-compressed and unpacked by Unity's own loader
# (decompression fallback). We do NOT send "Content-Encoding: br" for them: on unstable connections
# that broke wasm loading. Images can be cached for a day.
/book/img/*
  Cache-Control: public, max-age=86400

/img/*
  Cache-Control: public, max-age=86400
